# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Both are optional: without them the classifier still runs.

# Telegram bot front end (python -m app.bot). Get one from @BotFather.
TELEGRAM_BOT_TOKEN=

# Scam-type enrichment via Gemini. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override of the model id (default gemini-flash-lite-latest).
# GEMINI_MODEL=
