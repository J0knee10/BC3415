      "parameters": {
        "jsCode": "// Stage A: Normalize the form. No secrets; mock educational use only.\nreturn $input.all().map(item => {\n  const d=item.json;\n  const team_id=String(d.team_id??'').trim().slice(0,20);\n  const student_alias=String(d.student_alias??'').trim().slice(0,60);\n  const request_type=String(d.request_type??'General').trim().slice(0,50);\n  const request_text=String(d.request_text??'').trim().slice(0,500);\n  return {json:{team_id,student_alias,request_type,request_text,\n    received_at:new Date().toISOString(),\n    notification_text:`Week 10 class request\\nTeam: ${team_id}\\nAlias: ${student_alias}\\nType: ${request_type}\\nRequest: ${request_text}`}};\n});",
        "mode": "runOnceForAllItems"
      },
