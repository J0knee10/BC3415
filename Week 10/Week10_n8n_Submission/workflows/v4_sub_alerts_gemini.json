      "name": "Telegram: urgent HOLD alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        560,
        80
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ \"You are an accounts-payable process analyst at a training company. A deterministic rule engine has ALREADY decided this invoice's status; you only explain it.\\n\\nInvoice: \" + $json.invoice_id + \" from \" + $json.supplier + \", amount $\" + $json.amount_usd + \", PO \" + ($json.po_id || \"none\") + \".\\nStatus (fixed): \" + $json.status + \"\\nFlags: \" + $json.control_flags + \"\\nRule reason: \" + $json.reason + \"\\n\\nWrite 2 short sentences for the AP reviewer: what the risk is and what to check before approving. Do NOT change or question the status, do NOT say the invoice is approved, paid or ready for payment, do NOT ask for personal or bank details.\" }}"
      },
      "id": "00000000-0000-4000-8000-000000000014",
      "name": "Gemini: explain the review (advisory)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        560,
        320
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-flash-lite-latest",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "00000000-0000-4000-8000-000000000015",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        560,
        540
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Guardrail: the model may explain, never decide. Pair each AI answer with its case (same order),\n// reject text that claims approval/payment or names a different status, and fall back to the rule reason.\nconst cases = $('Route by priority').all(1);\nconst STATUSES = ['READY_FOR_HUMAN_CHECK','HOLD_INVALID_DATA','HOLD_DUPLICATE','HOLD_BANK_CHANGE','REVIEW_MISSING_PO','REVIEW_UNKNOWN_PO',\n  'REVIEW_PO_CLOSED','REVIEW_PO_SUPPLIER','REVIEW_PO_ALREADY_INVOICED','REVIEW_AMOUNT_MISMATCH','REVIEW_SPLIT_SUSPECTED','REVIEW_MANAGER'];\nconst FORBIDDEN = /(approved for payment|has been (approved|paid)|is approved|been paid|payment (has been|was|is) (made|sent|released|scheduled)|ready for payment|authori[sz]ed? (the |this )?payment|i (have )?approved|bank (account|details) (number|to)|send (us|me) your)/i;\nreturn $input.all().map((item, i) => {\n  const c = cases[i].json;\n  const raw = String(item.json.text ?? item.json.output ?? '').trim();\n  const otherStatus = STATUSES.find(s => s !== c.status && raw.includes(s));\n  const problems = [];\n  if (!raw) problems.push('empty answer');\n  if (FORBIDDEN.test(raw)) problems.push('claims approval/payment or asks for bank details');\n  if (otherStatus) problems.push('mentions a different status ' + otherStatus);\n  const passed = problems.length === 0;\n  const ai_commentary = passed ? raw.slice(0, 900) : `[withheld by guardrail: ${problems.join('; ')}] Rule reason: ${c.reason}`;\n  const ai_guardrail = passed ? 'PASSED' : 'BLOCKED';\n  return { json: { ...c, ai_commentary, ai_guardrail,\n    telegram_text: `${c.telegram_text}\\n\\nAI note (advisory, guardrail ${ai_guardrail}): ${ai_commentary}` } };\n});"
      },
      "id": "00000000-0000-4000-8000-000000000016",
      "name": "Guardrail + join with rule output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        320
      ]
    },
    {
      "parameters": {
